<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ControlLicencias.Views.ConfigView">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
                <Border Width="44" Height="44" Background="{DynamicResource AccentSoft}" CornerRadius="12">
                    <Path Data="{StaticResource IconConfig}" Fill="{DynamicResource PrimaryColor}" Width="22" Height="22" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Configuración de Telegram" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Bot que recibe y aprueba las solicitudes de activación" Foreground="{DynamicResource SubText}" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <Border Classes="Card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Data="{StaticResource IconLicencia}" Fill="{DynamicResource PrimaryColor}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Bot de Telegram" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Classes="FormLabel" Text="Token del bot" />
                    <TextBox Name="TxtToken" ToolTip.Tip="Token del bot de Telegram" VerticalContentAlignment="Center">
                        <TextBox.InnerLeftContent>
                            <Path Data="{StaticResource IconLlave}" Fill="{DynamicResource SubText}" Width="16" Height="16" Margin="4,0,8,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <TextBlock Classes="FormLabel" Text="ID del administrador (chat)" />
                    <TextBox Name="TxtAdminId" ToolTip.Tip="ID numérico del chat del administrador" VerticalContentAlignment="Center">
                        <TextBox.InnerLeftContent>
                            <Path Data="{StaticResource IconUsuarios}" Fill="{DynamicResource SubText}" Width="16" Height="16" Margin="4,0,8,0" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <Button Classes="PrimaryBtn" Click="Guardar_Click" HorizontalAlignment="Left" ToolTip.Tip="Guardar configuración">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource IconGuardar}" Fill="White" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Guardar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Name="LblEstado" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
