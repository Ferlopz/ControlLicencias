<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ControlLicencias.Views.LicenciaNuevaWindow"
        Title="Nueva licencia"
        Width="440" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        Background="{DynamicResource Background}">
    <Border Background="{DynamicResource Surface}"
            CornerRadius="16"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            BoxShadow="0 12 32 0 #33000000"
            Margin="16">
        <Grid>
            <Button Classes="CloseBtn" Click="Cancelar_Click" ToolTip.Tip="Cerrar"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" ZIndex="10">
                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
            </Button>

            <StackPanel Margin="30,32,30,24" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
                    <Border Width="40" Height="40" Background="{DynamicResource AccentSoft}" CornerRadius="11">
                        <Path Data="{StaticResource IconLicencia}" Fill="{DynamicResource PrimaryColor}" Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Nueva licencia" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Classes="FormLabel" Text="Cliente" />
                <TextBlock Name="LblCliente" FontWeight="SemiBold" FontSize="14" />

                <TextBlock Classes="FormLabel" Text="Producto" />
                <Button Name="BtnProducto" Classes="GhostBtn" Click="ToggleProductos_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="Elegir producto">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="LblProductoSeleccionado" Text="Seleccionar producto" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Path Grid.Column="1" Data="M7,10L12,15L17,10H7Z" Fill="{DynamicResource SubText}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <ListBox Name="LstProductos" IsVisible="False" Height="64" SelectionChanged="LstProductos_SelectionChanged" />

                <TextBlock Name="LblError" IsVisible="False" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Classes="GhostBtn" Content="Cancelar" Click="Cancelar_Click" />
                    <Button Classes="PrimaryBtn" Click="Crear_Click" ToolTip.Tip="Crear licencia">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource IconNuevo}" Fill="White" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Crear" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
