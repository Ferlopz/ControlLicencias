<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ControlLicencias.Views.LicenciaEditarWindow"
        Title="Licencia"
        Width="860" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">
    <Border Background="{DynamicResource Surface}"
            CornerRadius="20"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            BoxShadow="0 24 60 0 #40000000">
        <Grid>
            <Button Classes="CloseBtn" Click="Cancelar_Click" ToolTip.Tip="Cerrar"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" ZIndex="10">
                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
            </Button>

            <Grid RowDefinitions="Auto,*,Auto" Margin="30,30,30,20">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
                    <Border Width="40" Height="40" Background="{DynamicResource AccentSoft}" CornerRadius="11">
                        <Path Data="{StaticResource IconLicencia}" Fill="{DynamicResource PrimaryColor}" Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="LblTitulo" Text="Editar licencia" FontSize="17" FontWeight="Bold" />
                        <TextBlock Name="LblSubtitulo" Text="" FontSize="12" Foreground="{DynamicResource SubText}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,14,0">
                            <TextBlock Classes="FormLabel" Text="Cliente" />
                            <TextBlock Name="LblCliente" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />

                            <TextBlock Classes="FormLabel" Text="Código de activación" />
                            <TextBox Name="TxtCodigo" Height="36" />

                            <TextBlock Classes="FormLabel" Text="Cantidad de PCs" />
                            <TextBox Name="TxtPCs" Height="36" ToolTip.Tip="Número máximo de PCs" />

                            <TextBlock Classes="FormLabel" Text="Fecha de expiración (yyyy-MM-dd)" />
                            <TextBox Name="TxtExpiracion" Height="36" ToolTip.Tip="Formato yyyy-MM-dd (vacío = sin expiración)" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0">
                            <TextBlock Classes="FormLabel" Text="Producto" />
                            <TextBlock Name="LblProducto" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />

                            <TextBlock Classes="FormLabel" Text="Cantidad de usuarios" />
                            <TextBox Name="TxtUsuarios" Height="36" ToolTip.Tip="Número máximo de usuarios" />

                            <CheckBox Name="ChkActiva" Content="Licencia activa" Margin="0,14,0,0" ToolTip.Tip="Si está desactivada, la licencia no valida" />
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1">
                        <TabItem Header="Dispositivos">
                            <Border Background="{DynamicResource CardBackground}" CornerRadius="0,0,12,12" Padding="0" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <DataGrid Name="LstDispositivos"
                                          AutoGenerateColumns="False"
                                          CanUserSortColumns="True"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PC" Binding="{Binding NombrePC}" Width="*" />
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="90" />
                                        <DataGridTextColumn Header="Machine ID" Binding="{Binding MachineId}" Width="2*" />
                                        <DataGridTemplateColumn Header="Estado" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding EstadoBg}" CornerRadius="999" Padding="10,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding EstadoColor}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding EstadoColor}" FontSize="12" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="64">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Classes="IconBtn" Click="ToggleDispositivoItem_Click" ToolTip.Tip="Activar / desactivar dispositivo" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconPower}" Fill="{DynamicResource PrimaryColor}" Width="16" Height="16" Stretch="Uniform" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </TabItem>

                        <TabItem Header="Usuarios autorizados">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                    <TextBox Name="TxtNuevoUsuario" PlaceholderText="Nombre de usuario autorizado" Width="240" ToolTip.Tip="Nombre de usuario autorizado" VerticalContentAlignment="Center" />
                                    <Button Classes="PrimaryBtn" Click="AgregarUsuario_Click" ToolTip.Tip="Agregar usuario">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Data="{StaticResource IconNuevo}" Fill="White" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="Agregar" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Border Background="{DynamicResource CardBackground}" CornerRadius="12,12,0,0" Padding="0" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <DataGrid Name="LstUsuarios"
                                              AutoGenerateColumns="False"
                                              CanUserSortColumns="True"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Usuario" Binding="{Binding UserName}" Width="*" />
                                            <DataGridTemplateColumn Header="Estado" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding EstadoBg}" CornerRadius="999" Padding="10,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding EstadoColor}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding EstadoColor}" FontSize="12" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="" Width="64">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="IconBtn" Click="ToggleUsuarioItem_Click" ToolTip.Tip="Activar / desactivar usuario" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconPower}" Fill="{DynamicResource PrimaryColor}" Width="16" Height="16" Stretch="Uniform" />
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <TextBlock Name="LblEstado" VerticalAlignment="Center" Foreground="{DynamicResource Danger}" Margin="0,0,12,0" />
                    <Button Classes="GhostBtn" Content="Cancelar" Click="Cancelar_Click" />
                    <Button Classes="PrimaryBtn" Click="Guardar_Click" ToolTip.Tip="Guardar licencia">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource IconGuardar}" Fill="White" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Guardar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
